    {"id": "debug.debugError", "label": "debugError is absent", "feature": "Debug session reports no error", "area": "debugger", "gate": "release", "doc": "BUILD_AND_DEBUG.md"},
    {"id": "debug.paused", "label": "debugger paused at the breakpoint", "feature": "Breakpoint hit", "area": "debugger", "gate": "release", "doc": "BUILD_AND_DEBUG.md"},
