{
  "version": 1,
  "updated": "2026-11-13",
  "about": "Every end-to-end regression check GoIDEA runs, the feature it protects, the doc that describes it, and the gate that must pass before code lands. scripts/check-regression-index.py keeps the ids in sync with scripts/e2e-checks.py, so a check cannot be dropped or renamed silently.",
  "gates": {
    "pr": {
      "when": "every pull request and every push",
      "command": "scripts/gate.sh pr",
      "steps": [
        "gofmt -l . is empty",
        "CGO_ENABLED=0 go vet ./...",
        "CGO_ENABLED=0 go test ./... -skip TestTerminalMovesToLockedRightColumn",
        "CGO_ENABLED=0 go build ./cmd/goidea",
        "scripts/check-licenses.sh",
        "scripts/check-regression-index.py"
      ],
      "runs_in": ".github/workflows/ci.yml (test job, ubuntu-latest)"
    },
    "main": {
      "when": "a merge or push to main",
      "command": "scripts/gate.sh main",
      "steps": [
        "the pr gate",
        "scripts/e2e.sh offline: real openidea-server, real Maven build and run"
      ],
      "runs_in": ".github/workflows/ci.yml (e2e job, macOS, gated by the ENABLE_MACOS_CI variable)"
    },
    "release": {
      "when": "scripts/release.sh, before signing and notarizing",
      "command": "scripts/gate.sh release",
      "steps": [
        "the pr gate",
        "scripts/e2e.sh online: toolchain install, JDT language server, debugger"
      ],
      "runs_in": "scripts/release.sh"
    }
  },
  "checks": [
    {"id": "base.backend", "label": "backend is up", "feature": "Backend process and RPC handshake", "area": "openidea-rpc", "gate": "main", "doc": "RPC_PROTOCOL.md"},
    {"id": "base.tabs", "label": "a file is open in a tab", "feature": "Startup file restore", "area": "editor", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.edited", "label": "edit reached the backend", "feature": "Buffer to doc_change sync", "area": "editor", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.undone", "label": "undo round-tripped", "feature": "Backend undo mirrored into the buffer", "area": "editor", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.outline", "label": "outline names the Java class", "feature": "Document outline", "area": "editor", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.search.done", "label": "project search finished", "feature": "Project-wide search", "area": "search", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.search.files", "label": "project search scanned the sources", "feature": "Project-wide search covers the tree", "area": "search", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.search.matches", "label": "project search found matches", "feature": "Project-wide search returns hits", "area": "search", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.searchError", "label": "searchError is absent", "feature": "Project-wide search reports no error", "area": "search", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.diff.rows", "label": "Git diff has rows", "feature": "Diff view over a working-tree change", "area": "vcs", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.diffError", "label": "diffError is absent", "feature": "Diff view reports no error", "area": "vcs", "gate": "main", "doc": "EDITOR.md"},
    {"id": "base.commands", "label": "command palette is populated", "feature": "Command palette", "area": "workbench", "gate": "main", "doc": "README.md"},
    {"id": "base.settings.opened", "label": "settings sheet opened", "feature": "Settings sheet", "area": "workbench", "gate": "main", "doc": "README.md"},
    {"id": "base.settings.closed", "label": "settings sheet closed", "feature": "Settings sheet dismissal", "area": "workbench", "gate": "main", "doc": "README.md"},
